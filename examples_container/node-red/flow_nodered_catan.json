    {
        "id": "750fe52f6638b5ba",
        "type": "function",
        "z": "933937f791348941",
        "name": "UOI-Config",
        "func": "// Example: Configuration Digital Output / Input\n// Catan Index 13 bis 14\n\n//    UOI_TYPE_DONT_CHANGE = 0;\n//    UOI_TYPE_DEFAULT = 1;\n//    UOI_TYPE_DO = 2;\n//    UOI_TYPE_DI = 3;\n//    UOI_TYPE_COUNTER = 4;\n//    UOI_TYPE_AO_VOLTAGE = 5;\n\n// -----------------------------------------\n// Configure Type with number from above\n\nconst configurations = [\n    { id: 13, enabled: 3, name: \"13\", configured: 3,  type: 5 },  \n    { id: 14, enabled: 3, name: \"14\", configured: 3, type: 5 }\n];\n\n// -----------------------------------------\n\nconst messages = configurations.map(cfg => {\n    return {\n        url: `coap://169.254.253.1/uoi/${cfg.id}/cfg`,\n        protobufType: \"Catan.Uoi.UoiCfgReq\",\n        payload: {\n            \"type\": cfg.type,\n            \"enabled\": cfg.enabled,\n            \"name\": {\n                \"val\": cfg.name,\n                \"setting\": 2\n            },\n            \"configured\": cfg.configured\n        }\n    };\n});\n\nreturn [ messages ];",
        "outputs": 1,
