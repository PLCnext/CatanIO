    {
        "id": "2b1170827f6910d5",
        "type": "function",
        "z": "11fa33973bfd05e7",
        "name": "DOI - write",
        "func": "// Catan IOs DOI 9 to 12, only possible when configured as digital output\n// Write value for digital out, recommend value: 2 or 3\n//    BOOLEAN_SET_DONT_CHANGE = 0;\n//    BOOLEAN_SET_DEFAULT = 1;\n//    BOOLEAN_SET_FALSE = 2;\n//    BOOLEAN_SET_TRUE = 3;\n\n//---------------------------------------------\n// Set value:\n\nconst configurations = [\n    { id: 9, digitalSetVal: 3 },  \n    { id: 10, digitalSetVal: 3 },\n    { id: 11, digitalSetVal: 3 }, \n    { id: 12, digitalSetVal: 3 }\n];\n\n//---------------------------------------------\n\nconst messages = configurations.map(cfg => {\n    return {\n        url: `coap://169.254.253.1/doi/${cfg.id}`,\n        protobufType: \"Catan.Doi.UoiReq\",\n        payload: {\n            \"digitalSetVal\": cfg.digitalSetVal\n        }\n    };\n});\n\nreturn [ messages ];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 210,
        "y": 240,
        "wires": [
            [
                "f8fefc84b184bc49"
            ]
        ]
    },
    {
        "id": "21025805e444a72e",
        "type": "function",
        "z": "11fa33973bfd05e7",
        "name": "UOI - write",
        "func": "// Catan IOs UOI 13 and 14, only possible when configured as digital or analog output\n// Write value for digital out, recommend value: 2 or 3\n//    BOOLEAN_SET_DONT_CHANGE = 0;\n//    BOOLEAN_SET_DEFAULT = 1;\n//    BOOLEAN_SET_FALSE = 2;\n//    BOOLEAN_SET_TRUE = 3;\n\n// Analog range 0..10 (in volt, Float)\n\n// Define configurations for the various I/Os\n// For each ID choose: \n// activeType: \"analog\"  (or)\n// activeType: \"digital\"\n//---------------------------------------------\n// Set value:\n\nconst configurations = [\n    { id: 13, activeType: \"analog\", analogValue: 8, digitalValue: 2 }, \n    { id: 14, activeType: \"analog\", analogValue: 10, digitalValue: 2 }\n];\n\n//---------------------------------------------\n\nconst messages = configurations.map(cfg => {\n    let payloadStructure = {};\n    if (cfg.activeType === \"analog\") {\n        payloadStructure = {\n            \"analogSetVal\": {\n                \"val\": cfg.analogValue,\n                \"setting\": 2 \n            },\n            \"digitalSetVal\": 2 \n        };\n    } \n    else if (cfg.activeType === \"digital\") {\n        payloadStructure = {\n            \"digitalSetVal\": cfg.digitalValue, \n            \"analogSetVal\": {\n                \"val\": 0,\n                \"setting\": 2 \n            }\n        };\n    }\n\n    return {\n        url: `coap://169.254.253.1/uoi/${cfg.id}/state`,\n        protobufType: \"Catan.Uoi.UoiReq\",\n        payload: payloadStructure\n    };\n});\n\nreturn [ messages ];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 210,
        "y": 440,
        "wires": [
            [
                "a889f7b948ec0b7e"
            ]
        ]
    },
