        "id": "55b9130cd7c16c93",
        "type": "function",
        "z": "933937f791348941",
        "name": "DOI-Config",
        "func": "// Example: Configuration Universal Output / Inputs\n// Catan C1 Index 9 to 12\n\n//    UOI_TYPE_DONT_CHANGE = 0;\n//    UOI_TYPE_DEFAULT = 1;\n//    UOI_TYPE_DO = 2;\n//    UOI_TYPE_DI = 3;\n//    UOI_TYPE_COUNTER = 4;\n\n// -----------------------------------------\n// Configure Type with number from above\nconst configurations = [\n    { id: 9, enabled: 3, name: \"9\", configured: 3, type: 2 },  \n    { id: 10, enabled: 3, name: \"10\", configured: 3, type: 2 },\n    { id: 11, enabled: 3, name: \"11\", configured: 3, type: 2 }, \n    { id: 12, enabled: 3, name: \"12\", configured: 3, type: 2 }\n];\n\n// -----------------------------------------\n\nconst messages = configurations.map(cfg => {\n    return {\n        url: `coap://169.254.253.1/doi/${cfg.id}/cfg`,\n        protobufType: \"Catan.Doi.UoiCfgReq\",\n        payload: {\n            \"type\": cfg.type,\n            \"enabled\": cfg.enabled,\n            \"name\": {\n                \"val\": cfg.name,\n                \"setting\": 2\n            },\n            \"configured\": cfg.configured\n        }\n    };\n});\n\nreturn [ messages ];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
