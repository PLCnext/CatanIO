    {
        "id": "734aecdab1550ec3",
        "type": "function",
        "z": "933937f791348941",
        "name": "UI-Config",
        "func": "// Konfigurationen für die verschiedenen IOs definieren\n\n// UI_TYPE_DONT_CHANGE = 0;\n// UI_TYPE_DEFAULT = 1; // depends on model; UI_TYPE_VOLTAGE preferred\n// UI_TYPE_AI_VOLTAGE = 2;\n// UI_TYPE_AI_CURRENT_0_20 = 3;\n// UI_TYPE_AI_RESISTOR_10K = 4;\n// UI_TYPE_AI_RESISTOR_180K = 5;\n// UI_TYPE_AI_TEMPERATURE_PT1000_DIN = 6;\n// UI_TYPE_AI_TEMPERATURE_PT1000_SAMA = 7;\n// UI_TYPE_AI_TEMPERATURE_NI1000_DIN = 8;\n// UI_TYPE_AI_TEMPERATURE_NI1000_SAMA = 9;\n// UI_TYPE_AI_TEMPERATURE_NI1000_LG = 10;\n// UI_TYPE_DI = 11;\n// UI_TYPE_COUNTER = 12;\n// UI_TYPE_AI_TEMPERATURE_NTC_10K = 13;\n// UI_TYPE_AI_TEMPERATURE_NTC_10K_PRE = 14;\n// UI_TYPE_AI_TEMPERATURE_NTC_20K = 15;\n// UI_TYPE_AI_CURRENT_4_20 = 16;\n\n// -----------------------------------------\n// Configure Type with number from above\nconst configurations = [\n    { id: 1, enabled: 3, name: \"1\", configured: 3, type: 2, covIncrement: 1},  \n    { id: 2, enabled: 3, name: \"2\", configured: 3, type: 2, covIncrement: 1},\n    { id: 3, enabled: 3, name: \"3\", configured: 3, type: 11, covIncrement: 1}, \n    { id: 4, enabled: 3, name: \"4\", configured: 3, type: 11, covIncrement: 1},\n    { id: 5, enabled: 3, name: \"5\", configured: 3, type: 5, covIncrement: 1},  \n    { id: 6, enabled: 3, name: \"6\", configured: 3, type: 5, covIncrement: 1},\n    { id: 7, enabled: 3, name: \"7\", configured: 3, type: 6, covIncrement: 1},\n    { id: 8, enabled: 3, name: \"8\", configured: 3, type: 2, covIncrement: 1}\n];\n\n// -----------------------------------------\n\nconst messages = configurations.map(cfg => {\n    return {\n        url: `coap://169.254.253.1/ui/${cfg.id}/cfg`,\n        protobufType: \"Catan.Ui.UiCfgReq\",\n        payload: {\n            \"type\": cfg.type,\n            \"enabled\": cfg.enabled,\n            \"name\": {\n                \"val\": cfg.name,\n                \"setting\": 2 \n            },\n            \"covIncrement\": {\n                \"val\": cfg.covIncrement,\n                \"setting\": 2\n            },\n            \"configured\": cfg.configured\n        }\n    };\n});\n\nreturn [ messages ];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 100,
        "wires": [
